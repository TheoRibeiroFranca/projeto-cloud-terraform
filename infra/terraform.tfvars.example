# Copie para terraform.tfvars (ignorado pelo Git) e ajuste se precisar.
# Não coloque senhas aqui: segredos vêm do Secrets Manager.
project     = "convcommerce"
environment = "sp"
region      = "sa-east-1"
az_count    = 2

ecs_instance_type  = "t3.small"
vpc_cidr           = "10.10.0.0/16"
single_nat_gateway = true
rds_multi_az       = false
ecs_min_instances  = 2
ecs_max_instances  = 6

image_tag      = "2"
build_images   = true
app_source_dir = "../.."

alarm_emails = ["theoptbr@gmail.com"]
admin_email  = "admin@cirro.test"
